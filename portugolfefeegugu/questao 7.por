programa {
  funcao inicio() {
    inteiro nota1
    inteiro nota2
    escreva("digite a primeira nota:")
    leia(nota1)
    escreva("digite a segunda nota:")
    leia(nota2)
    inteiro media=(nota1+nota2)/2
    se (media>=7){
      escreva("aprovado")
    }
    senao{
      escreva("reprovado")
    }


  }
}
